# Python
__pycache__/
*.py[cod]
*.egg-info/
.Python
build/
dist/

# Virtualenv (managed by uv; recreate with `uv sync`)
.venv/

# Run records + derived index (telemetry, safe to delete) and gate records (evidence: deleting
# them costs the right to propose a guidance change until the gates are re-run — see ADR-008).
# Both stay out of git: they are machine-local, and a team enforces the gate in CI instead.
.whetstone/

# Console frontend: built assets are generated at packaging time, never committed
node_modules/
src/whetstone/ui/static/
ui/openapi.json
.playwright-mcp/

# The throwaway skills repo the sharpening demo builds; recreated on every run.
examples/*/workspace/

# Tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Local env / secrets
.env
.env.*
# ...except the committed template, which holds names and no values.
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
